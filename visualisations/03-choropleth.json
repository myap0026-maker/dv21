{
  "title": {
    "text": "03 · Where is hive density highest?",
    "subtitle": "Recorded hives per 1,000 km², normalising hive totals by state land area.",
    "anchor": "start",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#6D6257",
    "offset": 14
  },
  "width": "container",
  "height": 430,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME === 'New South Wales' ? 371.4044 : datum.properties.STATE_NAME === 'Queensland' ? 60.9889 : datum.properties.STATE_NAME === 'South Australia' ? 70.9825 : datum.properties.STATE_NAME === 'Tasmania' ? 347.2171 : datum.properties.STATE_NAME === 'Victoria' ? 542.0103 : datum.properties.STATE_NAME === 'Western Australia' ? 19.3818 : null",
      "as": "HiveDensity"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
  },
  "encoding": {
    "color": {
      "field": "HiveDensity",
      "type": "quantitative",
      "scale": {
        "scheme": "yelloworangebrown"
      },
      "legend": {
        "title": "Hives / 1,000 km²",
        "format": ".0f"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "HiveDensity",
        "type": "quantitative",
        "title": "Hives / 1,000 km²",
        "format": ".1f"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#FFFDF8",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#E8DFD1",
      "labelColor": "#5C5147",
      "titleColor": "#493D32",
      "domainColor": "#BDAF9E",
      "tickColor": "#BDAF9E"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#5C5147",
      "titleColor": "#493D32"
    },
    "title": {
      "font": "Arial",
      "subtitleFont": "Arial",
      "anchor": "start",
      "color": "#3F3023",
      "subtitleColor": "#65584A"
    },
    "view": {
      "stroke": null
    },
    "concat": {
      "spacing": 30
    },
    "background": "#FFFDF8",
    "range": {
      "category": [
        "#C47A16",
        "#2F6F9F",
        "#E2B84B",
        "#6C5A49",
        "#7E9DB5",
        "#D9A66C"
      ]
    }
  },
  "padding": {
    "left": 40,
    "right": 85,
    "top": 30,
    "bottom": 45
  }
}