{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#FFFDF8",

  "title": {
    "text": "01 · Commercial beekeepers are a small minority",
    "subtitle": "Each square represents approximately 1% of registered Australian beekeepers.",
    "anchor": "start",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#6D6257",
    "offset": 14
  },

  "width": 700,
  "height": 280,

  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "step": 1,
      "as": "id"
    }
  },

  "transform": [
    {
      "calculate": "datum.id % 10",
      "as": "column"
    },
    {
      "calculate": "floor(datum.id / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.id < 6 ? 'Commercial' : 'Recreational'",
      "as": "Beekeeper type"
    }
  ],

  "mark": {
    "type": "square",
    "size": 360,
    "cornerRadius": 2
  },

  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },

    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },

    "color": {
      "field": "Beekeeper type",
      "type": "nominal",
      "scale": {
        "domain": [
          "Commercial",
          "Recreational"
        ],
        "range": [
          "#C47A16",
          "#E7C98D"
        ]
      },
      "legend": {
        "title": "Beekeeper type",
        "orient": "bottom",
        "direction": "horizontal"
      }
    },

    "tooltip": [
      {
        "field": "Beekeeper type",
        "type": "nominal",
        "title": "Beekeeper type"
      }
    ]
  },

  "config": {
    "font": "Arial",

    "title": {
      "font": "Arial",
      "subtitleFont": "Arial",
      "color": "#3F3023"
    },

    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#5C5147",
      "titleColor": "#493D32"
    },

    "view": {
      "stroke": null
    }
  }
}