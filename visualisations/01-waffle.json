{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#FFFDF8",
  "width": "container",
  "height": 300,
  "padding": {
    "left": 25,
    "right": 25,
    "top": 20,
    "bottom": 35
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": "01 · Commercial beekeepers are a small minority",
    "subtitle": "Each square represents approximately 1% of registered Australian beekeepers.",
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#6D6257",
    "fontWeight": "bold",
    "subtitleFontWeight": "normal",
    "offset": 16
  },
  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "step": 1,
      "as": "id"
    }
  },
  "transform": [
    {
      "calculate": "datum.id % 10",
      "as": "column"
    },
    {
      "calculate": "floor(datum.id / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.id < 6 ? 'Commercial' : 'Recreational'",
      "as": "BeekeeperType"
    }
  ],
  "mark": {
    "type": "square",
    "size": 430,
    "stroke": "#FFFDF8",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "BeekeeperType",
      "type": "nominal",
      "title": "Beekeeper type",
      "scale": {
        "domain": [
          "Commercial",
          "Recreational"
        ],
        "range": [
          "#C47A16",
          "#E7C98D"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": null,
        "offset": 15
      }
    },
    "tooltip": [
      {
        "field": "BeekeeperType",
        "type": "nominal",
        "title": "Beekeeper type"
      }
    ]
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "labelColor": "#5C5147"
    },
    "title": {
      "font": "Arial",
      "subtitleFont": "Arial",
      "color": "#3F3023",
      "subtitleColor": "#65584A"
    }
  }
}